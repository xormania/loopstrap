# Runtime roots. These are exactly the prefixes that
# artifacts/instance/tools/verify-tree.py treats as permitted runtime extras
# (RUNTIME_PREFIXES), so the seal and the ignore list agree by construction.
/repos/
/.worktrees/
/xor/
/scratch/

# Untracked working notes. Also excluded from the seal by EXCLUDED_NAMES in
# seal-tree.py and verify-tree.py: a path that is sealed but never committed
# would fail verify-tree on a fresh clone.
/proj/

# Dev-lane symbolic tooling. .serena/ is excluded from the seal at the root
# (config/seal.v1.json) because Serena writes memories and an LSP cache here
# during ordinary use. The project configuration is committed so the setup is
# shared and reviewable; nothing Serena writes is.
/.serena/*
!/.serena/project.yml

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
