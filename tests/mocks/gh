#!/usr/bin/env bash
# Contract-strict gh mock.
set -uo pipefail
if [ "$#" = 1 ] && [ "$1" = "--version" ]; then echo "gh version 2.45.0 (MOCK)"; exit 0; fi
case "${1:-} ${2:-}" in
  "auth status"|"auth setup-git") exit 0 ;;
  "repo clone")
    [ "$#" -ge 4 ] || { echo "mock gh: repo clone requires repo and destination" >&2; exit 64; }
    repo="${3#*/}"; git clone -q "${MOCK_ORIGIN_DIR:-/tmp/mockorigin}/$repo.git" "$4" 2>/dev/null ;;
  "pr create")
    echo "https://mock/pull/1" ;;
  "pr merge")
    git push -q origin HEAD:main 2>/dev/null ;;
  "pr list")
    echo "" ;;
  *) echo "mock gh: unsupported invocation: $*" >&2; exit 64 ;;
esac
